{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/types",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  // Host-side assembled Web snapshots merge Context declarations from both
  // planes, so they remain in tsconfig.host.json rather than this client
  // project. The remaining client snapshots stay in this project.
  "exclude": [
    "tests/scaffold.ts",
    "tests/minimal-preset.snapshot.ts",
    "tests/message-feedback-protocol.snapshot.ts"
  ],
  "references": [
    {
      "path": "../../packages/client/web"
    },
    {
      "path": "../../packages/client/modules"
    }
  ]
}
