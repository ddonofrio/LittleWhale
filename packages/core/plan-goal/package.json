{
  "name": "@ddonofrio/littlewhale-plan-goal",
  "description": "Derive and persist the next goal for direct user requests",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
